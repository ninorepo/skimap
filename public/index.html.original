<!DOCTYPE html>
<html lang="en">
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<head>
		<style>
* {
	padding: 0px;
	margin: 0px;
}

#hud, #dialog-content {
	position: absolute;
	left: 0px;
	top: 0px;
	z-index: 9999;
}

#map {
	width: 100%;
	height: 100%;
}
		</style>
	</head>
	<body>
		<header>
		</header>
		<main>
			<div id="hud">
				<h1>SKI Map<h1>
    				<h2></h2>
				<button id="choose-year">Pilih Tahun</button>
			</div>
			<div id="map"></div>
		</main>
		<footer>
		</footer>

		<dialog id="dialog-years">
			<button id="dialog-years-cancel">x<button>
		</dialog>
		<dialog id="dialog-content">
			<div class="navigation">
				<button id="dialog-content-close">x</button>
			</div>
			<div id="content">
			</div>
		</dialog>

<script src="https://cdn.jsdelivr.net/npm/globe.gl@2.46.2/dist/globe.gl.min.js"></script>
<script src="/index.js"></script>
	</body>
</html>
