<!doctype html>
<html>
	<meta lang="en">
	<meta enctype="UTF-8">
	<head>
		<title>Admin Page</title>
<style>
* {
	box-sizing: border-box;
	padding: 0px;
	margin: 0px;
}

#editor-dialog	{
	position: absolute;
	z-index: 1;
	width: 100%;
	height: 100%;
	left: 0px;
	top: 0px;
	background-color: rgba(0, 0, 0, 0.5);
}

.hide {
	display: none;
}

</style>
	</head>
	<body>
		<main>
			<section id="control">
				<button id="add-history" data-edit-mode="insert">Add History</button>
				<button id="add-city-button">Add City</button>
			</section>
			<section id="content-list">
				<div class="container">
				</div>
			</section>
			<section id="pagination">
				<div class="container">
				</div>
			</section>
			<section id="editor-dialog" class="hide">
				<div class="container">
					<form id="editor-form">
						<input type="hidden" name="update" value="">
						<input type="hidden" name="id" value="">
						<label>Title<label>
						<input id="title" type="text" name="title">
						<label>Year</label>
						<input id="year" type="text" name="year" placeholder="contoh: 1945">
						<input id="masehi" type="radio" name="era" value="masehi" checked>Masehi
						<input id="sebelum-masehi" type="radio" name="era" value="sebelum masehi" >Sebelum Masehi
						<label>Location</label>
						<span>
							<select name="city">
								<option value="empty">Empty</option>
							</select>
						</span>
						<label for="editor">Content</label>
						<textarea id="editor" name="content"></textarea>
						<button id="cancel-editor" type="button">Cancel</button>
						<button id="submit" type="submit">Submit</button>
					</form>	
				</div>
			</section>
		</main>
		<footer>
		</footer>
		<dialog id="add-city">
  		  	<input id="city-name" type="text" placeholder="City" required>
    			<input id="city-latitude" type="number" step="any" placeholder="Latitude" required>
    			<input id="city-longitude" type="number" step="any" placeholder="Longitude" required>
    			<button id="cancel-add-city" type="button">Cancel</button>
    			<button id="submit-add-city" type="button">Submit</button>
		</dialog>
		<dialog id="confirm-modal">
			<div id="confirm-message">
				<h4>Question</h4>
				<p>Description<p>
			</div>
			<button id="confirm-no">No</button>
			<button id="confirm-yes">Yes</button>
		</dialog>
  		<script src="https://cdn.jsdelivr.net/npm/hugerte@1/hugerte.min.js"></script>
		<script src="/admin.js"></script>
	</body>
</html>
